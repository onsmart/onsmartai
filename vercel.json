{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/elevenlabs-config",
      "destination": "/api/elevenlabs?action=config"
    },
    {
      "source": "/api/elevenlabs-signed-url",
      "destination": "/api/elevenlabs?action=signed-url"
    },
    {
      "source": "/api/elevenlabs-conversation-token",
      "destination": "/api/elevenlabs?action=conversation-token"
    },
    { "source": "/api/cms/public", "destination": "/cms/public.json" },
    { "source": "/api/platform/config.js", "destination": "/platform/config.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
