# Preencha localmente. Nunca envie .env ou valores reais ao GitHub.
NODE_ENV=development
PORT=3000
# MySQL local (ex.: Docker): mysql://onsmartai:onsmartai@127.0.0.1:3306/onsmartai
DATABASE_URL=

# Infraestrutura autorizada para autenticação e armazenamento.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_API_URL=
MANUS_API_KEY=
MANUS_API_BROWSER_KEY=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# Formulário de contato (SendGrid — recomendado)
CONTACT_TO_EMAIL=marketing@onsmart.com.br
SENDGRID_API_KEY=
# Remetente verificado no SendGrid (Single Sender ou domínio autenticado)
SENDGRID_FROM="Onsmart.AI Site <noreply@onsmart.com.br>"

# Alternativa: SMTP do SendGrid (SMTP_USER=apikey, SMTP_PASSWORD=mesma API key)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=
# SMTP_FROM="Onsmart.AI Site <noreply@onsmart.com.br>"
